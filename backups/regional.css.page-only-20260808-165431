#page-regional {
  position: absolute !important;
  inset: 0 !important;
  width: 1091px !important;
  height: 820px !important;
  overflow: hidden !important;
  background: #001244 !important;
  isolation: isolate !important;
}

/* all regional layers match the real screen size */
#regional-basemap,
#regional-frame,
#regional-dots {
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  width: 1091px !important;
  height: 820px !important;
  inset: auto !important;
  transform: none !important;
}

/* map on bottom */
#regional-basemap {
  z-index: 1 !important;
  background: #001244 !important;
}

/* WeatherSTAR PNG in front of map */
#regional-frame {
  z-index: 50 !important;
  display: block !important;
  background: none !important;
  pointer-events: none;
}

#regional-frame-img {
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  width: 1091px !important;
  height: 820px !important;
  max-width: none !important;
  max-height: none !important;
  transform: none !important;
  display: block !important;
  pointer-events: none;
  z-index: 51 !important;
}

/* dots on top */
#regional-dots {
  z-index: 100 !important;
  display: block !important;
  pointer-events: none;
}

.regional-dot {
  position: absolute !important;
  z-index: 101 !important;
  transform: translate(-50%, -50%);
  text-align: center;
  pointer-events: none;
  text-shadow:
    -2px -2px 0 #000,
     2px -2px 0 #000,
    -2px  2px 0 #000,
     2px  2px 0 #000;
}

.regional-marker {
  width: 7px;
  height: 7px;
  background: white;
  border-radius: 50%;
  margin: 0 auto 2px;
}

.regional-dot img {
  width: 42px;
  image-rendering: pixelated;
  display: block;
  margin: 0 auto;
}

.regional-temp {
  color: #ffff00;
  font-size: 23px;
  line-height: 1;
}

.regional-name {
  color: white;
  font-size: 20px;
  line-height: 1;
}

.leaflet-container {
  width: 1091px !important;
  height: 820px !important;
  background: #001244 !important;
  font-family: Star4000, monospace;
}

.leaflet-pane,
.leaflet-map-pane,
.leaflet-tile-pane,
.leaflet-overlay-pane,
.leaflet-marker-pane {
  z-index: 1 !important;
}

.leaflet-tile {
  filter:
    saturate(0.75)
    contrast(1.25)
    brightness(0.92)
    sepia(0.08) !important;
}

/* editor access */
body.editor-on #regional-frame,
body.editor-on #regional-frame-img,
body.editor-on #regional-dots,
body.editor-on .regional-dot {
  pointer-events: auto !important;
}

body.editor-on #regional-frame-img {
  cursor: move !important;
  outline: 2px dashed yellow !important;
}
/* National regional marker sizing */
.regional-dot img {
  width: 34px !important;
}

.regional-temp {
  color: #ffff00;
  font-size: 21px !important;
  line-height: 1;
}

.regional-name {
  color: white;
  font-size: 16px !important;
  line-height: 1;
}

.regional-marker {
  width: 6px !important;
  height: 6px !important;
}


