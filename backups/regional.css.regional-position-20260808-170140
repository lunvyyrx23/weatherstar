#page-regional {
  position: absolute !important;
  inset: 0 !important;
  width: 1091px !important;
  height: 820px !important;
  overflow: hidden !important;
  background: #001244 !important;
  isolation: isolate !important;
}

#regional-basemap,
#regional-frame,
#regional-dots {
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  width: 1091px !important;
  height: 820px !important;
}

#regional-basemap {
  z-index: 1 !important;
  background: #001244 !important;
}

#regional-frame {
  z-index: 50 !important;
  pointer-events: none !important;
}

#regional-frame-img {
  position: absolute !important;
  left: 0 !important;
  top: 0 !important;
  width: 1091px !important;
  height: 820px !important;
  max-width: none !important;
  max-height: none !important;
  display: block !important;
  pointer-events: none !important;
}

#regional-dots {
  z-index: 100 !important;
  pointer-events: auto !important;
}

.regional-dot {
  position: absolute !important;
  transform: translate(-50%, -50%) !important;
  text-align: center !important;
  pointer-events: auto !important;
  cursor: pointer !important;
}

.regional-temp,
.regional-name {
  font-weight: normal !important;
  filter: blur(var(--regional-text-blur, 0.55px)) !important;
  text-shadow:
    -2px -2px 0 #000,
     2px -2px 0 #000,
    -2px  2px 0 #000,
     2px  2px 0 #000,
     4px  4px 0 #000,
     5px  5px 0 #000 !important;
  text-transform: none !important;
  line-height: 1 !important;
}

.regional-temp {
  color: #ffff00 !important;
  font-family: var(--regional-temp-font, Star4000), monospace !important;
  font-size: var(--regional-temp-size, 35px) !important;
  letter-spacing: var(--regional-temp-letter, 0px) !important;
  margin-bottom: var(--regional-gap, 2px) !important;
}

.regional-name {
  color: #ffffff !important;
  font-family: var(--regional-name-font, Star4000Extended), monospace !important;
  font-size: var(--regional-name-size, 20px) !important;
  letter-spacing: var(--regional-name-letter, 0px) !important;
}

.regional-dot.selected-dot {
  outline: 2px dashed #ffff00 !important;
  outline-offset: 8px !important;
}

.maplibregl-control-container {
  display: none !important;
}

#regional-editor {
  position: fixed;
  right: 12px;
  top: 62px;
  z-index: 99999;
  width: 250px;
  background: rgba(0,0,0,.88);
  border: 2px solid #ffff00;
  color: white;
  padding: 10px;
  font-family: Arial, sans-serif !important;
  font-size: 13px;
}

#regional-editor * {
  font-family: Arial, sans-serif !important;
}

#regional-editor .title {
  color: #ffff00;
  font-weight: bold;
  font-size: 16px;
  margin-bottom: 8px;
}

#regional-editor label {
  display: block;
  margin-top: 8px;
}

#regional-editor select,
#regional-editor input,
#regional-editor button {
  width: 100%;
  margin-top: 3px;
}

#regional-export {
  margin-top: 10px;
  padding: 8px;
  background: #ffff00;
  color: #000;
  border: 0;
  font-weight: bold;
  cursor: pointer;
}